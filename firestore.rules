rules_version = '2';

// Security rules for the government document system (ระบบจัดเก็บเอกสารราชการ).
// The app signs every visitor in anonymously and relies entirely on these rules
// to keep the "documents" and "categories" collections safe — none of the
// client-side checks in script.js (field lengths, attachment format) are
// enforced unless mirrored here, since anyone can call the Firestore REST/SDK
// API directly with the public web config.
//
// Every field of the document form is optional, including the PDF, so the
// rules check types and lengths but never require text to be filled in.
//
// PDF files: new documents keep the file in Cloudflare R2 (uploaded through
// the Worker in worker/) and store only `storageKey` here. Older documents
// still carry the PDF as base64 in `fileData`; they stay readable/editable,
// but no write may add or change base64 anymore.
//
// This file has no effect until you deploy it:
//   firebase deploy --only firestore:rules
// Test it against real data with the Firestore Emulator first — a mismatched
// field name or type here will turn into permission-denied errors in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPdfDataUrl(value) {
      return value is string
        && value.matches('^data:application/pdf;base64,.*')
        // 700KB binary, base64-inflated (~4/3), plus headroom.
        && value.size() <= 960000;
    }

    // Key the Worker generates for every upload: documents/<year>/<UUID>.pdf
    function isStorageKey(value) {
      return value is string
        && value.matches('^documents/[0-9]{4}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]pdf$');
    }

    // At most one attachment kind: an R2 file (never mixed with base64), a
    // legacy base64 PDF from before the move to R2, or no file at all — then
    // none of the file fields may be present.
    function validAttachment(data) {
      return (
          'storageKey' in data
          && isStorageKey(data.storageKey)
          && !('fileData' in data)
          && 'fileName' in data
          && data.mimeType == 'application/pdf'
          && data.fileSize is number && data.fileSize > 0 && data.fileSize <= 20971520 // 20 * 1024 * 1024
        ) || (
          !('storageKey' in data)
          && isPdfDataUrl(data.fileData)
          && 'fileName' in data
          && data.fileSize is number && data.fileSize > 0 && data.fileSize <= 716800 // 700 * 1024
        ) || (
          !data.keys().hasAny(['storageKey', 'fileData', 'fileName', 'fileSize', 'mimeType'])
        );
    }

    function validDocument(data) {
      return data.keys().hasOnly([
          'title', 'docNumber', 'receiveNumber', 'date', 'agency', 'category', 'status', 'urgency',
          'section', 'description', 'deleted', 'deletedAt', 'createdAt', 'createdAtMs',
          'updatedAt', 'fileName', 'fileSize', 'fileData',
          'storageKey', 'mimeType', 'createdBy'
        ])
        && data.title is string && data.title.size() <= 300
        && data.docNumber is string && data.docNumber.size() <= 100
        // เลขที่รับ, optional: only หนังสือรับ has one. The web app writes it only when
        // one is filled in, or '' when one is cleared. A record without it has none.
        && (!('receiveNumber' in data) || (data.receiveNumber is string && data.receiveNumber.size() <= 100))
        && data.date is string && data.date.size() <= 10
        && data.agency is string && data.agency.size() <= 300
        && data.category is string && data.category.size() <= 200
        // สถานะ: the web app no longer offers one. It writes '' on new records, and older
        // records keep the value they were saved with, so every former value stays allowed.
        && data.status in ['', 'approved', 'pending', 'rejected', 'in-progress', 'completed', 'cancelled']
        // ชั้นความเร็ว, optional: the web app writes it only for an urgent document,
        // or '' when one is set back to ปกติ. A record without it is ปกติ.
        && (!('urgency' in data) || data.urgency in ['', 'urgent', 'very-urgent', 'most-urgent'])
        // งานที่รับผิดชอบ, optional, documents only (orders have none): written only when
        // one is chosen, or '' when one is cleared. Must match SECTION_LABEL in script.js.
        && (!('section' in data) || data.section in ['', 'palat', 'finance', 'engineering', 'education',
          'health', 'clerk', 'disaster', 'general-affairs', 'human-resources', 'policy-planning'])
        && data.description is string && data.description.size() <= 5000
        && data.deleted is bool
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 260))
        && validAttachment(data);
    }

    match /documents/{docId} {
      allow read: if signedIn();

      // New documents point at R2 or have no file; base64 PDFs can no longer be created.
      // createdBy must be the caller's own uid, never a value the client picked.
      allow create: if signedIn()
        && validDocument(request.resource.data)
        && request.resource.data.deleted == false
        && !('fileData' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      // A full add/edit resends every field (validated above). Soft-delete
      // and restore only ever touch deleted/deletedAt, so they're allowed
      // through a narrower check instead of the full schema.
      // Legacy base64 may only be kept untouched or removed (when the user
      // attaches a new file to R2), and createdBy never changes.
      allow update: if signedIn()
        && (
          (
            validDocument(request.resource.data)
            && (
              !('fileData' in request.resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fileData'])
            )
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy'])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
            && request.resource.data.deleted is bool
          )
        );

      // Permanent deletion only from the trash, the way the web app does it,
      // so a document can't skip the trash and vanish in one step.
      allow delete: if signedIn() && resource.data.deleted == true;
    }

    // คำอธิบาย สี และไอคอนของหมวดหมู่ ล้วนไม่บังคับ: หมวดที่ไม่มีใช้ค่าตั้งต้นของหน้าเว็บ
    // สีและไอคอนต้องอยู่ในชุดที่ป๊อบอัปให้เลือก (CATEGORY_COLORS และ CATEGORY_ICONS ใน script.js)
    function validCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && (!('color' in data) || data.color in ['#2A78D6', '#EB6834', '#1BAF7A', '#E09A00', '#6B5BD2', '#D55181', '#0E9AA7', '#5E6A85'])
        && (!('icon' in data) || data.icon in ['chat', 'inbox', 'clipboard', 'stamp', 'send', 'folder', 'building', 'tag', 'archive', 'copy']);
    }

    match /categories/{categoryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'description', 'color', 'icon'])
        && validCategory(request.resource.data)
        && request.resource.data.createdAt is number;

      // Edits keep the id, so documents stay linked: the ✏️ popup (name, description,
      // colour, icon) and renaming a built-in category (RENAMED_CATEGORIES in script.js).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'color', 'icon'])
        && validCategory(request.resource.data);
      allow delete: if signedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
