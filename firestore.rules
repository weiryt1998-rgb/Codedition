rules_version = '2';

// Security rules for the government document system (ระบบจัดเก็บเอกสารราชการ).
// The app signs every visitor in anonymously and relies entirely on these rules
// to keep the "documents" and "categories" collections safe — none of the
// client-side checks in script.js (required fields, attachment format) are
// enforced unless mirrored here, since anyone can call the Firestore REST/SDK
// API directly with the public web config.
//
// PDF files: new documents keep the file in Cloudflare R2 (uploaded through
// the Worker in worker/) and store only `storageKey` here. Older documents
// still carry the PDF as base64 in `fileData`; they stay readable/editable,
// but no write may add or change base64 anymore.
//
// This file has no effect until you deploy it:
//   firebase deploy --only firestore:rules
// Test it against real data with the Firestore Emulator first — a mismatched
// field name or type here will turn into permission-denied errors in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPdfDataUrl(value) {
      return value is string
        && value.matches('^data:application/pdf;base64,.*')
        // 700KB binary, base64-inflated (~4/3), plus headroom.
        && value.size() <= 960000;
    }

    // Key the Worker generates for every upload: documents/<year>/<UUID>.pdf
    function isStorageKey(value) {
      return value is string
        && value.matches('^documents/[0-9]{4}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]pdf$');
    }

    // Exactly one attachment kind: an R2 file (never mixed with base64), or a
    // legacy base64 PDF from before the move to R2.
    function validAttachment(data) {
      return (
          'storageKey' in data
          && isStorageKey(data.storageKey)
          && !('fileData' in data)
          && data.mimeType == 'application/pdf'
          && data.fileSize is number && data.fileSize > 0 && data.fileSize <= 20971520 // 20 * 1024 * 1024
        ) || (
          !('storageKey' in data)
          && isPdfDataUrl(data.fileData)
          && data.fileSize is number && data.fileSize > 0 && data.fileSize <= 716800 // 700 * 1024
        );
    }

    function validDocument(data) {
      return data.keys().hasOnly([
          'title', 'docNumber', 'date', 'agency', 'category', 'status',
          'description', 'deleted', 'deletedAt', 'createdAt', 'createdAtMs',
          'updatedAt', 'fileName', 'fileSize', 'fileData',
          'storageKey', 'mimeType', 'createdBy'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.docNumber is string && data.docNumber.size() > 0 && data.docNumber.size() <= 100
        && data.date is string && data.date.size() > 0 && data.date.size() <= 10
        && data.agency is string && data.agency.size() <= 300
        && data.category is string && data.category.size() <= 200
        && data.status in ['approved', 'pending', 'rejected']
        && data.description is string && data.description.size() <= 5000
        && data.deleted is bool
        && data.fileName is string && data.fileName.size() <= 260
        && validAttachment(data);
    }

    match /documents/{docId} {
      allow read: if signedIn();

      // New documents always point at R2; base64 PDFs can no longer be created.
      // createdBy must be the caller's own uid, never a value the client picked.
      allow create: if signedIn()
        && validDocument(request.resource.data)
        && request.resource.data.deleted == false
        && !('fileData' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      // A full add/edit resends every field (validated above). Soft-delete
      // and restore only ever touch deleted/deletedAt, so they're allowed
      // through a narrower check instead of the full schema.
      // Legacy base64 may only be kept untouched or removed (when the user
      // attaches a new file to R2), and createdBy never changes.
      allow update: if signedIn()
        && (
          (
            validDocument(request.resource.data)
            && (
              !('fileData' in request.resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fileData'])
            )
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy'])
          )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        );

      allow delete: if signedIn();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt is number;

      // The only edit the app makes is renaming a built-in category
      // (RENAMED_CATEGORIES in script.js), which keeps its id so documents stay linked.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if signedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
